+/* with AdaptOpts::lock_tag set, no collapse removes a locked vertex */
+static Read<I8> check_collapse_lock(Mesh* mesh, AdaptOpts const& opts,
+    LOs cands2edges, Read<I8> cand_codes) {
+  if (opts.lock_tag.empty()) return cand_codes;
+  if (!mesh->has_tag(VERT, opts.lock_tag)) {
+    Omega_h_fail(
+        "lock tag \"%s\" is not on the vertices\n", opts.lock_tag.c_str());
+  }
+  auto verts_are_locked = mesh->get_array<I8>(VERT, opts.lock_tag);
+  auto edge_verts2verts = mesh->ask_verts_of(EDGE);
+  auto ncands = cands2edges.size();
+  auto cand_codes_w = Write<I8>(ncands);
+  auto f = OMEGA_H_LAMBDA(LO cand) {
+    auto code = cand_codes[cand];
+    auto edge = cands2edges[cand];
+    for (Int eev = 0; eev < 2; ++eev) {
+      if (verts_are_locked[edge_verts2verts[edge * 2 + eev]]) {
+        code = dont_collapse(code, eev);
+      }
+    }
+    cand_codes_w[cand] = code;
+  };
+  parallel_for(ncands, f, "check_collapse_lock");
+  return cand_codes_w;
+}
