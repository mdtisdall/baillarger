diff --git a/src/unit_lock.cpp b/src/unit_lock.cpp
new file mode 100644
index 00000000..50b41ffe
--- /dev/null
+++ b/src/unit_lock.cpp
@@ -0,0 +1,238 @@
+#include "Omega_h_adapt.hpp"
+#include "Omega_h_array_ops.hpp"
+#include "Omega_h_build.hpp"
+#include "Omega_h_library.hpp"
+#include "Omega_h_mesh.hpp"
+
+#include <array>
+#include <cmath>
+#include <iostream>
+#include <map>
+#include <vector>
+
+using namespace Omega_h;
+
+/* Tests for AdaptOpts::lock_tag: no edge collapse removes a locked vertex. */
+
+using Point = std::array<Real, 3>;
+using Triangle = std::array<Point, 3>;
+
+static Mesh make_box(Library* lib) {
+  return build_box(lib->world(), OMEGA_H_SIMPLEX, 1., 1., 1., 4, 4, 4);
+}
+
+/* lock = 1 on boundary vertices. If lock_split_points, also on boundary
+   edges and faces: a split point inherits the value of the split edge,
+   and an edge cut across a boundary face inherits the face's value. */
+static void add_lock(Mesh* mesh, AdaptOpts* opts, bool lock_split_points) {
+  auto dim = mesh->dim();
+  for (Int d = 0; d <= dim; ++d) {
+    auto class_dim = HostRead<I8>(mesh->get_array<I8>(d, "class_dim"));
+    auto lock = HostWrite<I8>(mesh->nents(d));
+    for (LO i = 0; i < mesh->nents(d); ++i) {
+      bool on_boundary = class_dim[i] < dim;
+      bool locked = (d == VERT) || lock_split_points;
+      lock[i] = I8(on_boundary && locked);
+    }
+    mesh->add_tag(d, "lock", 1, Read<I8>(lock.write()));
+  }
+  opts->lock_tag = "lock";
+  opts->xfer_opts.type_map["lock"] = OMEGA_H_INHERIT;
+}
+
+static void set_size(Mesh* mesh, Real h) {
+  if (mesh->has_tag(VERT, "metric")) mesh->remove_tag(VERT, "metric");
+  mesh->add_tag(VERT, "metric", 1, Reals(mesh->nverts(), 1.0 / (h * h)));
+}
+
+static Point point_of(HostRead<Real> const& coords, LO v) {
+  return {coords[v * 3 + 0], coords[v * 3 + 1], coords[v * 3 + 2]};
+}
+
+static std::vector<Point> boundary_points(Mesh* mesh) {
+  auto coords = HostRead<Real>(mesh->coords());
+  auto class_dim = HostRead<I8>(mesh->get_array<I8>(VERT, "class_dim"));
+  std::vector<Point> out;
+  for (LO v = 0; v < mesh->nverts(); ++v) {
+    if (class_dim[v] < mesh->dim()) out.push_back(point_of(coords, v));
+  }
+  return out;
+}
+
+/* exact coordinates -> lock value of the vertex there (0 if no lock tag) */
+static std::map<Point, I8> points_to_lock(Mesh* mesh) {
+  auto coords = HostRead<Real>(mesh->coords());
+  bool has_lock = mesh->has_tag(VERT, "lock");
+  auto lock = has_lock ? HostRead<I8>(mesh->get_array<I8>(VERT, "lock"))
+                       : HostRead<I8>();
+  std::map<Point, I8> out;
+  for (LO v = 0; v < mesh->nverts(); ++v) {
+    out[point_of(coords, v)] = has_lock ? lock[v] : I8(0);
+  }
+  return out;
+}
+
+static std::vector<Triangle> boundary_triangles(Mesh* mesh) {
+  auto coords = HostRead<Real>(mesh->coords());
+  auto class_dim = HostRead<I8>(mesh->get_array<I8>(FACE, "class_dim"));
+  auto fv2v = HostRead<LO>(mesh->ask_verts_of(FACE));
+  std::vector<Triangle> out;
+  for (LO f = 0; f < mesh->nfaces(); ++f) {
+    if (class_dim[f] >= mesh->dim()) continue;
+    Triangle tri;
+    for (Int k = 0; k < 3; ++k) tri[k] = point_of(coords, fv2v[f * 3 + k]);
+    out.push_back(tri);
+  }
+  return out;
+}
+
+static Point sub(Point a, Point b) {
+  return {a[0] - b[0], a[1] - b[1], a[2] - b[2]};
+}
+static Real dot3(Point a, Point b) {
+  return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+static Point cross3(Point a, Point b) {
+  return {a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2],
+      a[0] * b[1] - a[1] * b[0]};
+}
+static Real area(Triangle const& t) {
+  auto n = cross3(sub(t[1], t[0]), sub(t[2], t[0]));
+  return 0.5 * std::sqrt(dot3(n, n));
+}
+
+/* true if p is in the plane of t and its barycentric weights are >= 0 */
+static bool in_triangle(Point p, Triangle const& t, Real tol) {
+  auto e1 = sub(t[1], t[0]);
+  auto e2 = sub(t[2], t[0]);
+  auto n = cross3(e1, e2);
+  auto nn = dot3(n, n);
+  auto d = sub(p, t[0]);
+  if (std::abs(dot3(d, n)) / std::sqrt(nn) > tol) return false;
+  auto a = dot3(cross3(d, e2), n) / nn;
+  auto b = dot3(cross3(e1, d), n) / nn;
+  return a >= -tol && b >= -tol && a + b <= 1 + tol;
+}
+
+/* every new boundary triangle is inside one old boundary triangle,
+   and the total area is the same */
+static bool is_subdivided(
+    std::vector<Triangle> const& before, std::vector<Triangle> const& after) {
+  Real tol = 1e-12;
+  Real area_before = 0, area_after = 0;
+  for (auto& t : before) area_before += area(t);
+  for (auto& t : after) {
+    area_after += area(t);
+    bool found = false;
+    for (auto& T : before) {
+      if (in_triangle(t[0], T, tol) && in_triangle(t[1], T, tol) &&
+          in_triangle(t[2], T, tol)) {
+        found = true;
+        break;
+      }
+    }
+    if (!found) return false;
+  }
+  return std::abs(area_before - area_after) < 1e-12;
+}
+
+static void check_valid(Mesh* mesh) {
+  OMEGA_H_CHECK(get_min(mesh->ask_sizes()) > 0.0);
+  OMEGA_H_CHECK(mesh->min_quality() > 0.0);
+}
+
+/* the number of points that are still mesh vertices (exact coordinates) */
+static LO count_kept(std::vector<Point> const& points, Mesh* mesh) {
+  auto now = points_to_lock(mesh);
+  LO kept = 0;
+  for (auto& p : points) kept += LO(now.count(p));
+  return kept;
+}
+
+static void adapt_to(Mesh* mesh, AdaptOpts const& opts, Real h) {
+  set_size(mesh, h);
+  adapt(mesh, opts);
+}
+
+/* coarsening with the boundary locked keeps every boundary vertex */
+static void test_lock_coarsen(Library* lib) {
+  auto mesh = make_box(lib);
+  AdaptOpts opts(&mesh);
+  opts.verbosity = SILENT;
+  add_lock(&mesh, &opts, false);
+  auto points = boundary_points(&mesh);
+  auto tris = boundary_triangles(&mesh);
+  auto nverts0 = mesh.nverts();
+  adapt_to(&mesh, opts, 0.6);
+  auto kept = count_kept(points, &mesh);
+  std::cout << "lock coarsen: verts " << nverts0 << " -> " << mesh.nverts()
+            << ", boundary kept " << kept << " of " << points.size() << '\n';
+  OMEGA_H_CHECK(mesh.nverts() < nverts0); /* the interior did coarsen */
+  OMEGA_H_CHECK(kept == LO(points.size()));
+  auto now = points_to_lock(&mesh);
+  for (auto& p : points) OMEGA_H_CHECK(now[p] == 1);
+  OMEGA_H_CHECK(is_subdivided(tris, boundary_triangles(&mesh)));
+  check_valid(&mesh);
+}
+
+/* control: the same run without the lock removes boundary vertices */
+static void test_control_coarsen(Library* lib) {
+  auto mesh = make_box(lib);
+  AdaptOpts opts(&mesh);
+  opts.verbosity = SILENT;
+  auto points = boundary_points(&mesh);
+  adapt_to(&mesh, opts, 0.6);
+  auto kept = count_kept(points, &mesh);
+  std::cout << "control coarsen: boundary kept " << kept << " of "
+            << points.size() << '\n';
+  OMEGA_H_CHECK(kept < LO(points.size()));
+  check_valid(&mesh);
+}
+
+/* refine, then coarsen. A split point of a boundary edge is locked only
+   if the edge is locked. The original locked vertices always stay. */
+static void test_lock_split_points(Library* lib, bool lock_split_points) {
+  auto mesh = make_box(lib);
+  AdaptOpts opts(&mesh);
+  opts.verbosity = SILENT;
+  add_lock(&mesh, &opts, lock_split_points);
+  auto points0 = boundary_points(&mesh);
+  auto tris0 = boundary_triangles(&mesh);
+  adapt_to(&mesh, opts, 0.1);
+  auto points1 = boundary_points(&mesh);
+  auto tris1 = boundary_triangles(&mesh);
+  OMEGA_H_CHECK(points1.size() > points0.size()); /* the boundary was split */
+  OMEGA_H_CHECK(is_subdivided(tris0, tris1));
+  adapt_to(&mesh, opts, 0.6);
+  auto kept0 = count_kept(points0, &mesh);
+  auto kept1 = count_kept(points1, &mesh);
+  std::cout << "split points (locked " << lock_split_points
+            << "): original kept " << kept0 << " of " << points0.size()
+            << ", after refine kept " << kept1 << " of " << points1.size()
+            << '\n';
+  auto sub0 = is_subdivided(tris0, boundary_triangles(&mesh));
+  std::cout << "  final boundary inside the original triangles: " << sub0
+            << '\n';
+  OMEGA_H_CHECK(kept0 == LO(points0.size()));
+  if (lock_split_points) {
+    /* the boundary only gains vertices: it stays a subdivision */
+    OMEGA_H_CHECK(kept1 == LO(points1.size()));
+    OMEGA_H_CHECK(is_subdivided(tris1, boundary_triangles(&mesh)));
+    OMEGA_H_CHECK(sub0);
+  } else {
+    /* unlocked split points can be collapsed again */
+    OMEGA_H_CHECK(kept1 < LO(points1.size()));
+  }
+  check_valid(&mesh);
+}
+
+int main(int argc, char** argv) {
+  auto lib = Library(&argc, &argv);
+  if (lib.world()->size() == 1) {
+    test_lock_coarsen(&lib);
+    test_control_coarsen(&lib);
+    test_lock_split_points(&lib, true);
+    test_lock_split_points(&lib, false);
+  }
+  return 0;
+}
